echo "▶ Formatting & linting..."

# Capture the list of files staged before formatting so we can re-stage
# exactly those after the formatter rewrites them. Without this, format
# changes land in the working tree but not in the commit, leaving a dirty
# tree and an un-formatted commit.
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

pnpm run format

if [ -n "$STAGED_FILES" ]; then
  # Re-add only files that still exist and were originally staged.
  echo "$STAGED_FILES" | while IFS= read -r file; do
    [ -f "$file" ] && git add -- "$file"
  done
fi
