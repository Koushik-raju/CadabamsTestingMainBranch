{
  "name": "cadabams-consult-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:prod": "cross-env NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "next start",
    "lint": "biome check ./app ./components ./hooks ./lib ./sdk ./scripts",
    "format": "biome check --write ./app ./components ./hooks ./lib ./sdk ./scripts",
    "generate:sdk": "openapi-ts",
    "generate:doctors-list": "tsx scripts/fetch-and-cache-doctors.ts",
    "mobile": "tsx scripts/mobile/index.ts",
    "mobile:ios:build": "tsx scripts/mobile/index.ts",
    "mobile:android:build": "tsx scripts/mobile/index.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "cap:sync": "npx cap sync",
    "cap:sync:ios": "npx cap sync ios",
    "cap:sync:android": "npx cap sync android",
    "cap:copy": "npx cap copy",
    "cap:copy:ios": "npx cap copy ios",
    "cap:copy:android": "npx cap copy android",
    "cap:update": "npx cap update",
    "cap:doctor": "npx cap doctor",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "cap:run:ios": "npx cap run ios",
    "cap:run:android": "npx cap run android",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "mobile:sync": "npx cap sync",
    "mobile:open:ios": "npx cap sync ios && npx cap open ios",
    "mobile:open:android": "npx cap sync android && npx cap open android",
    "mobile:run:ios": "npx cap sync ios && npx cap run ios",
    "ios": "npx cap sync ios && npx cap run ios --target \"$(xcrun simctl list devices booted | grep -Eo '\\([0-9A-F-]{36}\\)' | head -1 | tr -d '()')\"",
    "mobile:run:android": "npx cap sync android && npx cap run android",
    "mobile:devices:android": "adb devices",
    "mobile:clean": "rimraf ios/App/App/public android/app/src/main/assets/public",
    "mobile:debug:android": "npx cap sync android && cd android && ./gradlew assembleDebug",
    "mobile:release:android": "npx cap sync android && cd android && ./gradlew assembleRelease",
    "mobile:release:ios": "npx cap sync ios && xcodebuild -workspace ios/App/App.xcworkspace -scheme App -configuration Release",
    "mobile:doctor": "node -e \"const e=process.env;const ok=(k,v)=>console.log((v?'\\u2713':'\\u2717')+' '+k+(v?' = '+v:' missing'));ok('ANDROID_HOME',e.ANDROID_HOME||e.ANDROID_SDK_ROOT);ok('JAVA_HOME',e.JAVA_HOME);console.log('If ANDROID_HOME is missing: add \\'export ANDROID_HOME=/opt/homebrew/share/android-commandlinetools\\' (mac brew) or your SDK path to ~/.zshrc');\"",
    "cap:upgrade": "npm install @capacitor/core@latest @capacitor/cli@latest @capacitor/ios@latest @capacitor/android@latest && npx cap sync"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.176",
    "@capacitor/action-sheet": "^8.1.1",
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/core": "^8.3.1",
    "@capacitor/device": "^8.0.2",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.1",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/local-notifications": "^8.0.2",
    "@capacitor/push-notifications": "^8.0.3",
    "@capacitor/status-bar": "^8.0.2",
    "@capacitor/text-zoom": "^8.0.1",
    "@hookform/resolvers": "^5.2.2",
    "@mastra/ai-sdk": "^1.4.1",
    "@mastra/client-js": "^1.16.0",
    "@strapi/blocks-react-renderer": "^1.0.2",
    "ai": "^6.0.174",
    "axios": "^1.16.0",
    "capacitor-plugin-safe-area": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-codes-list": "^2.0.0",
    "dayjs": "^1.11.20",
    "dotenv": "^17.4.2",
    "embla-carousel-react": "^8.6.0",
    "emoji-picker-react": "^4.19.1",
    "firebase": "^12.12.1",
    "framer-motion": "^12.38.0",
    "js-cookie": "^3.0.5",
    "lite-youtube-embed": "^0.3.4",
    "lucide-react": "^1.14.0",
    "mixpanel-browser": "^2.78.0",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "oauth-1.0a": "^2.2.6",
    "posthog-js": "^1.372.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.5",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.5",
    "react-hook-form": "^7.75.0",
    "react-markdown": "^10.1.0",
    "react-razorpay": "^3.0.1",
    "react-textarea-autosize": "^8.5.9",
    "react-toastify": "^11.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.6.0",
    "streamdown": "^2.5.0",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@capacitor/cli": "^8.3.1",
    "@hey-api/client-axios": "^0.9.1",
    "@hey-api/openapi-ts": "^0.97.1",
    "@next/bundle-analyzer": "^16.2.4",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^11.0.0",
    "autoprefixer": "^10.5.0",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "postcss": "^8.5.13",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^6"
  }
}
