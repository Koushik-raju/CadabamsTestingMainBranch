# Copy this file to .env.local and fill in real values
# See config/env.ts for how these are consumed

NEXT_PUBLIC_ENV=production

# CRM API base URLs
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_BASE_URL_HOS=
NEXT_PUBLIC_BACKEND_URL=

# OAuth 1.0a — CRM
NEXT_PUBLIC_CONSUMER_KEY=
CONSUMER_SECRET=
ACCESS_TOKEN=
TOKEN_SECRET=

# OAuth 1.0a — Hospital
NEXT_PUBLIC_HOS_CONSUMER_KEY=
HOS_CONSUMER_SECRET=
HOS_ACCESS_TOKEN=
HOS_TOKEN_SECRET=

# Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Payment flow: "link" = redirect to Razorpay hosted Payment Link,
#               "inapp" = open Razorpay Standard Checkout modal in-page.
# Unset / unknown values fall back to "link".
NEXT_PUBLIC_PAYMENT_MODE=link

# Misc
NEXT_PUBLIC_BEARER_TOKEN=
NEXT_PUBLIC_ZEGO_URL=

# `pnpm generate:doctors-list` — scripts/fetch-and-cache-doctors.ts
ERP_BASE_URL=
CRM_BEARER_TOKEN=

# Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
